# Copy these settings to .env and replace every placeholder.
# Never commit real SMTP credentials.
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=replace-with-provider-app-password
SMTP_FROM="PyLearn <your-mailbox@example.com>"
FRONTEND_URL=http://localhost:3000
# Optional on Windows if soffice.exe is not available in PATH:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Optional directory for uploaded originals and generated PDFs:
# LESSON_SLIDE_DIR=C:\pylearn-data\lesson-slides
